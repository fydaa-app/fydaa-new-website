# Copy to .env.local and adjust. All variables are public (inlined into the client
# bundle at build time) – never put secrets here. Validated by src/config/env.ts.

# "prod" (default) or "stage". Staging builds are always noindex.
NEXT_PUBLIC_APP_ENV=prod

# Canonical site origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://fydaa.com

# Service base URLs. Each accepts an optional _PROD / _STAGE variant that wins for that
# environment. Production values below are also the built-in defaults.
NEXT_PUBLIC_BASE_URL=https://crm-prod.fydaa.com/
NEXT_PUBLIC_AUTH_BASE_URL=https://auth.fydaa.com/
NEXT_PUBLIC_ONBOARD_BASE_URL=https://onboarding.fydaa.com/
NEXT_PUBLIC_STOCK_BASE_URL=https://stocktransaction.fydaa.com/
NEXT_PUBLIC_ADMIN_BASE_URL=https://fydaa.in/admin/api/v4/
NEXT_PUBLIC_PAYMENT_BASE_URL=https://payment.fydaa.com/

# Staging has no CRM default – set it explicitly when NEXT_PUBLIC_APP_ENV=stage.
# NEXT_PUBLIC_BASE_URL_STAGE=https://crm-stage.example.com/

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sign in with Google / Apple for email linking (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
